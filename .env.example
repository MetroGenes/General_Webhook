# General Webhook 环境变量配置示例
# 复制为 .env 并填入真实值: cp .env.example .env

# 时区配置 (Docker 容器内使用)
TZ=Asia/Shanghai

# Webhook 数据目录必须预先创建；Compose 不会代建，以避免 root 所有权目录。
WEBHOOK_DATA_DIR=/data/webhook

# 容器固定 UID/GID。宿主机数据目录必须归该 UID/GID 所有。
WEBHOOK_UID=10001
WEBHOOK_GID=10001

# Docker 资源边界。适合低流量监控 webhook，可按实测负载调整。
WEBHOOK_CPU_LIMIT=0.50
WEBHOOK_MEMORY_LIMIT=256m
# RAM + swap 总上限；与内存硬限制相同表示默认禁用额外 swap。
WEBHOOK_MEMORY_SWAP_LIMIT=256m
WEBHOOK_MEMORY_RESERVATION=64m
WEBHOOK_PIDS_LIMIT=64
WEBHOOK_GOMEMLIMIT=192MiB
WEBHOOK_GOGC=50

# 默认拉取官方部署标签：主分支通过全部 CI 后更新 1.0.0 与 latest。
# 1.0.0 是可更新标签；固定版本/回滚请保存 sha-<完整提交 SHA> 或镜像 digest。
# 定制 configs/scripts 时改为自己的唯一镜像标签，再执行 build --pull。
WEBHOOK_IMAGE=ghcr.io/metrogenes/general_webhook:1.0.0

# 标准网络名称。若覆盖，创建命令和生产者 Compose 必须使用同一名称。
# internal 网络只允许明确批准的生产者容器加入。
WEBHOOK_INTERNAL_NETWORK=webhook-internal
WEBHOOK_EGRESS_NETWORK=webhook-egress

# Webhook source 与 action 参数。默认留空并拒绝启动；只填写实际启用的 source，
# 未使用的 source 从 configs/webhooks.yaml 删除后重新构建镜像。
# 独立管理接口 Bearer token，至少 16 字节；不要与任何 source token 复用。
# 凭据含 $ 时用单引号包裹值，避免 Compose 在读取 .env 时提前插值。
ADMIN_TOKEN=
GITHUB_SECRET=
CUSTOM_TOKEN=

# IM 机器人 webhook (示例 1, 4)
FEISHU_BOT=
DINGTALK_TOKEN=
DINGTALK_WEBHOOK_TOKEN=

# 内部宝塔容器或 relay -> Telegram (示例 3)。公网宝塔不能直连默认部署。
# BT_TOKEN: 随机字符串，同时填到同网络调用方的请求头 X-Webhook-Token
BT_TOKEN=
# TG_BOT_TOKEN: BotFather 创建机器人拿到的 token
TG_BOT_TOKEN=
# TG_CHAT_ID: 目标会话 id (个人/群/频道), 可向 @userinfobot 获取
TG_CHAT_ID=

# Deadman 心跳 (可选)：主动向 Uptime Kuma Push 监控项报告本地就绪 up/down。
# 不配置任何 URL 时心跳模块不启动。push URL 含凭据，必须经环境变量提供。
#   HEARTBEAT_URL/TOKEN   -> Uptime Kuma Push URL (+ 可选 X-Heartbeat-Token)
#   CF_HEARTBEAT_URL/TOKEN -> Cloudflare Pages 心跳接收器 (mode: json)
# Kuma 示例（复制监控项实际生成的 URL）：
# HEARTBEAT_URL='https://kuma.example.com/api/push/<token>?status=up&msg=OK&ping='
# 内部 HTTP：在 configs/webhooks.yaml 显式 allow_http: true 后重建自有标签镜像。
# Healthchecks：改 mode: healthchecks 后重建；UUID URL 是 https://hc-ping.com/<uuid>。
# 旧 mode: push 仍是 Healthchecks 协议别名；省略 mode 时现在使用 Kuma。
HEARTBEAT_URL=
HEARTBEAT_TOKEN=
CF_HEARTBEAT_URL=
CF_HEARTBEAT_TOKEN=
# 心跳 JSON 主机标识，最多 128 字节；每实例使用独立 Kuma 监控项与唯一 HOST_LABEL。
# 未设置时回退为 general-webhook。
HOST_LABEL=
# 仅本地构建使用：作为 build.args.VCS_REF 烘焙进镜像，建议填完整 Git commit SHA。
# 官方镜像自带 revision，Compose 不在运行时覆盖该字段。
GENERAL_WEBHOOK_GIT_COMMIT=
